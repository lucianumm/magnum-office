{
  "name": "advocacia-gestao",
  "version": "1.11.0",
  "private": true,
  "description": "Magnum Office 1.9 — Gestão jurídica local",
  "author": "Lucianum",
  "license": "SEE LICENSE IN LICENSE",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "electron .",
    "build": "vite build",
    "lint": "eslint .",
    "test": "node --test tests/*.test.cjs",
    "test:desktop": "node scripts/smoke.mjs",
    "test:features": "node scripts/features-smoke.mjs",
    "test:email": "node scripts/email-smoke.mjs",
    "check": "npm run lint && npm run format:check && npm test && npm run build",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb --x64 --publish never",
    "dist:mac": "npm run build && electron-builder --mac dmg zip --publish never",
    "release:manifest": "node scripts/release-manifest.mjs",
    "release:keys": "node scripts/signing-keys.mjs",
    "test:workspace": "node scripts/workspace-smoke.mjs",
    "assets": "node scripts/build-assets.mjs",
    "test:release-features": "node scripts/release-features-smoke.mjs",
    "test:privacy-email-backup": "node scripts/privacy-email-backup-smoke.mjs",
    "test:corrections": "node scripts/corrections-smoke.mjs",
    "test:birthdays": "node scripts/birthdays-smoke.mjs",
    "test:email-layout": "node scripts/email-layout-smoke.mjs",
    "test:update-e2e": "node scripts/update-e2e.mjs",
    "release:verify": "node scripts/release-verify.mjs",
    "test:manual-update": "node scripts/manual-update-smoke.mjs",
    "format": "prettier --write \"app/**/*.{mjs,cjs}\" \"backend/**/*.cjs\" \"desktop/**/*.cjs\" \"updater/**/*.cjs\" \"scripts/**/*.mjs\" \"tests/**/*.cjs\" \"frontend/src/**/*.{jsx,css}\" eslint.config.mjs vite.config.mjs",
    "format:check": "prettier --check \"app/**/*.{mjs,cjs}\" \"backend/**/*.cjs\" \"desktop/**/*.cjs\" \"updater/**/*.cjs\" \"scripts/**/*.mjs\" \"tests/**/*.cjs\" \"frontend/src/**/*.{jsx,css}\" eslint.config.mjs vite.config.mjs",
    "test:documents": "node scripts/documents-smoke.mjs",
    "test:tools": "node scripts/tools-smoke.mjs",
    "test:new-features": "node scripts/new-features-smoke.mjs",
    "test:whatsapp": "node scripts/whatsapp-smoke.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@hyzyla/pdfium": "3.0.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@signpdf/placeholder-pdf-lib": "4.0.0",
    "@signpdf/signer-p12": "4.0.0",
    "@signpdf/signpdf": "4.0.0",
    "@signpdf/utils": "4.0.0",
    "@tesseract.js-data/por": "1.0.0",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "csv-parse": "^7.0.3",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.577.0",
    "mammoth": "^1.13.0",
    "node-forge": "1.4.3",
    "pdf-lib": "^1.17.1",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanitize-html": "^2.18.1",
    "semver": "^7.7.4",
    "tesseract.js": "7.0.0",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.58.2",
    "@resvg/resvg-js": "^2.6.2",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "44.10.2",
    "electron-builder": "26.18.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "jsqr": "^1.4.0",
    "prettier": "^3.9.10",
    "vite": "8.3.6"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
